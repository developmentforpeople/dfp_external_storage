# X-Accel-Redirect target for dfp_external_storage.
#
# With this in place, /file/<File name>/<file_name> answers with an empty 200 carrying
#
#     X-Accel-Redirect: /dfp-s3-internal/<bucket>/<key>?<SigV4 query>
#
# and nginx streams the object from the S3 provider itself. Compared with redirecting
# the browser to a presigned URL, the client never leaves this site's origin (so no
# http:// mixed-content warning and no internal hostname to resolve), the provider is
# never exposed, Range requests and resume work, and no gunicorn worker is held open
# for the length of a multi-GB download.
#
# Setup
#   1. Copy this file next to the site's nginx config and `include` it from inside the
#      `server { }` block that serves the site. The `upstream` block goes in `http { }`.
#   2. Point `dfp_s3_backend` and the `Host` header below at the SAME host:port as the
#      DFP External Storage "Endpoint" field. SigV4 signs the Host header, so any
#      mismatch fails with SignatureDoesNotMatch (403), not a connection error.
#   3. Add to sites/common_site_config.json:
#          "dfp_x_accel_redirect_prefix": "/dfp-s3-internal/"
#      then `bench restart`. Leave it unset to keep the plain presigned redirect.
#
# The app also requires the request to carry `X-Use-X-Accel-Redirect`, which bench's
# nginx template already injects in `location @webserver` -- the same signal Frappe
# uses to serve private files through the `/protected/` internal location. If it is
# missing (a `bench serve` dev front end, or a non-nginx proxy) the app quietly falls
# back to redirecting the browser to the presigned URL, so a half-finished setup
# cannot hand anyone an empty 200.
#
# Verify with a ranged GET, not `curl -I`: a presigned URL signs the HTTP method, so a
# HEAD reaching the provider with a GET signature is rejected with 403. A 206 plus the
# right Content-Range on `curl -r 0-1023` proves the whole chain.
#
# This rides on the connection's own presigned settings: a file is only handed to nginx
# if "Presigned URLs" is checked and the file's mimetype matches
# "Presigned Mimetypes Starting". Everything else still streams through Frappe.
#
# Requires nginx as the front end. Traefik, Caddy and HAProxy have no equivalent to
# X-Accel-Redirect; with those, leave `dfp_x_accel_redirect_prefix` unset. Under
# frappe_docker the location belongs in the frontend container's config, and
# `X-Use-X-Accel-Redirect` must be set there too.

upstream dfp_s3_backend {
	server joshua.galcom.local:9000 fail_timeout=0;
	keepalive 8;
}

location /dfp-s3-internal/ {
	# Reachable only via X-Accel-Redirect from this site, never from a client.
	internal;

	# Must match the endpoint the URL was signed for, byte for byte.
	proxy_set_header Host joshua.galcom.local:9000;

	# The presigned query string is the credential. Anything the client sent would
	# either confuse the provider (an Authorization header takes precedence over a
	# query signature) or leak the desk session to it, so drop both.
	proxy_set_header Authorization "";
	proxy_set_header Cookie "";

	# Needed for the keepalive pool above, and for clean Range handling.
	proxy_http_version 1.1;
	proxy_set_header Connection "";

	# Stream straight through rather than spooling a multi-GB body to disk first.
	proxy_buffering off;
	proxy_request_buffering off;
	proxy_max_temp_file_size 0;

	# Per-read, not total: a slow client on a 15GB file is not a stalled upstream.
	proxy_connect_timeout 15s;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;

	proxy_hide_header x-amz-id-2;
	proxy_hide_header x-amz-request-id;

	# The trailing slash strips this location's prefix, leaving /<bucket>/<key>.
	# nginx decodes that path and re-encodes it for the upstream; the round trip is
	# signature-safe for normal keys, but note that `merge_slashes on` (the default)
	# would collapse a `//` inside a key and break the signature.
	proxy_pass http://dfp_s3_backend/;
}
